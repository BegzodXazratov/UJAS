<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Taqdiringizni Biling</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Creepster&family=Nosifer&family=Roboto:wght@400;700&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #050505;
            background-image: radial-gradient(circle at center, #2a0000 0%, #000000 70%);
            color: #ff3333;
            font-family: 'Roboto', sans-serif;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
        }

        /* 3D va qo'rqinchli effektlar uchun orqa fon */
        .blood-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: url('https://images.unsplash.com/photo-1505635552518-3448ff116af3?q=80&w=2000&auto=format&fit=crop') center/cover;
            opacity: 0.15;
            mix-blend-mode: multiply;
            pointer-events: none;
            z-index: 1;
        }

        .glitch-effect {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: repeating-linear-gradient(
                0deg,
                rgba(0, 0, 0, 0.15),
                rgba(0, 0, 0, 0.15) 1px,
                transparent 1px,
                transparent 2px
            );
            pointer-events: none;
            z-index: 2;
        }

        #start-btn {
            padding: 20px 40px;
            font-size: 24px;
            font-family: 'Nosifer', cursive;
            color: #8b0000;
            background: transparent;
            border: 2px solid #8b0000;
            cursor: pointer;
            z-index: 10;
            transition: all 0.3s;
            text-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
            box-shadow: 0 0 20px rgba(139, 0, 0, 0.2);
        }

        #start-btn:hover {
            color: #ff0000;
            border-color: #ff0000;
            box-shadow: 0 0 40px rgba(255, 0, 0, 0.8), inset 0 0 20px rgba(255, 0, 0, 0.5);
            transform: scale(1.05);
        }

        #generator-modal {
            display: none;
            flex-direction: column;
            background: rgba(10, 0, 0, 0.9);
            border: 1px solid #4a0000;
            padding: 40px;
            border-radius: 10px;
            z-index: 10;
            box-shadow: 0 0 50px rgba(255, 0, 0, 0.2);
            width: 90%;
            max-width: 500px;
            text-align: center;
            animation: fadeIn 2s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }

        h1 {
            font-family: 'Creepster', cursive;
            font-size: 36px;
            color: #ff1a1a;
            margin-bottom: 30px;
            text-shadow: 2px 2px 5px #000;
        }

        input {
            width: 100%;
            padding: 15px;
            margin-bottom: 20px;
            background: #111;
            border: 1px solid #330000;
            color: #ff6666;
            font-size: 18px;
            outline: none;
            transition: 0.3s;
        }

        input:focus {
            border-color: #ff0000;
            box-shadow: 0 0 15px rgba(255, 0, 0, 0.5);
        }

        #generate-btn {
            width: 100%;
            padding: 15px;
            font-size: 20px;
            font-weight: bold;
            color: #fff;
            background: #660000;
            border: none;
            cursor: pointer;
            transition: 0.3s;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        #generate-btn:hover {
            background: #aa0000;
            box-shadow: 0 0 20px #ff0000;
        }

        #result {
            margin-top: 30px;
            font-size: 22px;
            line-height: 1.5;
            color: #ffffff;
            text-shadow: 0 0 10px #ff0000;
            min-height: 80px;
        }
        
        .name-highlight {
            color: #ff0000;
            font-weight: bold;
            font-family: 'Creepster', cursive;
            font-size: 28px;
        }
    </style>
</head>
<body>

    <div class="blood-overlay"></div>
    <div class="glitch-effect"></div>

    <!-- YouTube Music (Dastlab yashirin) -->
    <div id="audio-container" style="display:none;"></div>

    <button id="start-btn">Eshikni Ochish...</button>

    <div id="generator-modal">
        <h1>Taqdiringiz bitilgan</h1>
        <input type="text" id="userName" placeholder="Ismingizni kiriting..." required autocomplete="off">
        <input type="number" id="userAge" placeholder="Yoshingizni kiriting..." required min="1" max="120">
        <button id="generate-btn">O'lim generatori</button>
        <div id="result"></div>
    </div>

    <script>
        const startBtn = document.getElementById('start-btn');
        const modal = document.getElementById('generator-modal');
        const generateBtn = document.getElementById('generate-btn');
        const resultDiv = document.getElementById('result');
        const audioContainer = document.getElementById('audio-container');

        // Boshlash tugmasi - musiqani yoqadi va formani ochadi
        startBtn.addEventListener('click', () => {
            // YouTube qoidasiga ko'ra avtomatik ishlashi uchun user click qilishi kerak
            audioContainer.innerHTML = `<iframe width="0" height="0" src="https://www.youtube.com/embed/MPa-y1LQjOk?autoplay=1&loop=1&playlist=MPa-y1LQjOk" frameborder="0" allow="autoplay"></iframe>`;
            
            startBtn.style.display = 'none';
            modal.style.display = 'flex';
        });

        // 200 tagacha kengaytirish mumkin bo'lgan bazaviy ro'yxatlar
        const locations = [
            "hojatxonada", "kimsasiz parkda", "qorong'i yo'lda", "tashlandiq eski binoda", 
            "keng daryo bo'yida", "o'z uyingizning yerto'lasida", "ishxonadagi lift ichida", 
            "shifoxonaning sovuq palatasida", "mashina o'rindig'ida", "poezd vagonida", 
            "samolyot hojatxonasida", "kimsasiz orolda", "yerto'la zinapoyasida", 
            "qalin o'rmon o'rtasida", "yerosti o'tish yo'lida", "cho'l o'rtasida", 
            "muzlagan ko'l ustida", "baland qoyalar ustida", "omborxonada", "zinapoyada",
            "avtomobil turargohida", "eski qabristonda", "ko'prik ostida"
            // Shu yerga yana qolgan joy nomlarini vergul bilan qo'shib ketaverasiz
        ];

        const causes = [
            "mashina urib ketib", "kutilmaganda yonib ketib", "suvga cho'kib ketib", 
            "balandlikdan yiqilib", "yurak xurujidan", "zaharli ilon chaqib", 
            "qotilning sovuq qurolidan", "tasodifiy o'q tegib", "kuchli tok urib", 
            "muzlab qolib", "ochlik va suvsizlikdan", "nafas qisib", 
            "yovvoyi hayvonlar hujum qilib", "kuchli portlash qurboni bo'lib", 
            "zaharli gazdan bo'g'ilib", "boshga og'ir jism tushib", "qorong'ida qoqinib ketib",
            "o'z qo'lingiz bilan", "avtohalokat tufayli majag'lanib", "sirli kasallikka chalinib",
            "chilla vaqtida oftob urib", "yashindek tez kelgan o'lim farishtasidan"
            // Shu yerga qolgan o'lim sabablarini qo'shishingiz mumkin
        ];

        function getRandomElement(arr) {
            return arr[Math.floor(Math.random() * arr.length)];
        }

        generateBtn.addEventListener('click', () => {
            const name = document.getElementById('userName').value.trim();
            const ageInput = document.getElementById('userAge').value;
            
            if (!name || !ageInput) {
                resultDiv.innerHTML = "<span style='color:red;'>Ism va yoshingizni kiritishingiz shart... Hali vaqtingiz bor.</span>";
                return;
            }

            const age = parseInt(ageInput);
            
            // Sana generatsiyasi (2026 yil 1 avgustdan boshlab hisoblaydi)
            const baseDate = new Date(2026, 7, 1); // 7 - bu Avgust (oylar 0 dan boshlanadi)
            
            // Insonning o'rtacha umrini maksimal 100 yosh deb olamiz, qolgan umrini hisoblaymiz
            let yearsLeft = 100 - age;
            if (yearsLeft < 1) yearsLeft = 2; // Agar yoshi juda katta bo'lsa, tez orada

            // Tasodifiy qolgan kunlar sonini topamiz
            const randomDaysLeft = Math.floor(Math.random() * (yearsLeft * 365));
            
            // O'lim sanasini aniqlaymiz
            const deathDate = new Date(baseDate.getTime() + (randomDaysLeft * 24 * 60 * 60 * 1000));
            
            const dd = String(deathDate.getDate()).padStart(2, '0');
            const mm = String(deathDate.getMonth() + 1).padStart(2, '0');
            const yyyy = deathDate.getFullYear();
            const formattedDate = `${dd}.${mm}.${yyyy}`;

            // Tasodifiy lokatsiya va holat
            const randomLocation = getRandomElement(locations);
            const randomCause = getRandomElement(causes);

            // Natijani chiqarish
            resultDiv.innerHTML = `<span class="name-highlight">${name}</span>... <br><br> 
            Siz <b>${formattedDate}</b> yilda, <br> <b>${randomLocation}</b>, <br> <b>${randomCause}</b> ... o'lasan.`;
            
            // Har safar bosilganda effekt berish uchun glitch qo'shamiz
            document.body.style.transform = `translate(${Math.random() * 5 - 2}px, ${Math.random() * 5 - 2}px)`;
            setTimeout(() => document.body.style.transform = 'translate(0,0)', 100);
        });
    </script>
</body>
</html>
